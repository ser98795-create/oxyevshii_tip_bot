# =====================================================================
# Конфигурация бота. Скопируйте этот файл в .env и заполните значения.
#   cp .env.example .env
# =====================================================================

# --- Telegram ---------------------------------------------------------
# Токен от @BotFather в Telegram.
BOT_TOKEN=123456789:AAEa...

# Список chat_id (через запятую), в которых боту разрешено отвечать.
# КАК УЗНАТЬ chat_id: добавьте бота в нужный чат и напишите команду /chatid —
# бот ответит числом. Скопируйте его сюда.
# Если оставить пустым, бот будет отвечать в любом чате — НЕ РЕКОМЕНДУЕТСЯ.
ALLOWED_CHAT_IDS=

# Список Telegram user_id (через запятую) тех, кому разрешено управлять ботом.
# Только эти пользователи могут вызывать /persona, /reload, /mute, /unmute, /status.
# КАК УЗНАТЬ свой user_id: напишите боту /whoami в личке (или в чате, где он есть)
# либо боту @userinfobot в Telegram. Это положительное число вида 123456789.
# Если оставить пустым — управляющие команды НЕ работают НИ ДЛЯ КОГО.
ADMIN_USER_IDS=

# --- LLM (OpenAI или OpenAI-совместимый прокси) -----------------------
# Ключ API. Если используете оригинальный OpenAI — это sk-... ключ с
# https://platform.openai.com/api-keys. Если используете российский прокси
# (proxyapi.ru / vsegpt.ru / neuroapi.host и т.п.) — ключ оттуда.
OPENAI_API_KEY=sk-...

# Базовый URL API. Для оригинального OpenAI оставьте ПУСТЫМ.
# Примеры значений для популярных прокси (актуальный URL смотрите на сайте сервиса):
#   proxyapi.ru:    https://api.proxyapi.ru/openai/v1
#   vsegpt.ru:      https://api.vsegpt.ru/v1
#   openrouter:     https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# Модель. По умолчанию gpt-4o-mini — дешёвая и достаточно умная для чата.
MODEL=gpt-4o-mini

# --- Поведение бота ---------------------------------------------------
# Минимальный интервал (в секундах) между «инициативными» сообщениями бота
# в одном чате. На прямые упоминания и реплаи лимит не распространяется.
COOLDOWN_SECONDS=60

# Сколько последних сообщений чата хранить в памяти как контекст.
HISTORY_SIZE=20

# Температура и максимальный размер ответа.
TEMPERATURE=0.8
MAX_TOKENS=600

# Уровень логов: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Прокси для Telegram API (опционально) ---------------------------
# Нужен, если сервер не имеет прямого доступа к api.telegram.org
# (типичная ситуация для российских VPS — Roskomnadzor блокирует Telegram).
# Если оставить пустым — бот ходит к Telegram напрямую.
#
# Поддерживаются HTTP и SOCKS5-прокси:
#   TELEGRAM_PROXY_URL=http://user:pass@host:port
#   TELEGRAM_PROXY_URL=socks5://user:pass@host:port
#   TELEGRAM_PROXY_URL=socks5://127.0.0.1:9050      # локальный Tor
#
# Где взять SOCKS5-прокси:
# — Запустить локально Tor (apt install tor) — бесплатно, но медленно;
#   адрес будет socks5://127.0.0.1:9050.
# — Купить у любого провайдера резидентных/датацентровых SOCKS5-прокси
#   (~50–200 руб/мес за один прокси хватит с запасом).
# — Поднять собственный VPN-туннель к не-российскому серверу.
#
# vsegpt.ru / другие российские LLM-прокси работают без прокси — этот
# параметр на них НЕ влияет. Здесь только Telegram.
TELEGRAM_PROXY_URL=

# --- HTTP(S)-прокси для всего остального (редко нужно) -----------------
# Если нужно отправлять и LLM-запросы через прокси (например, оригинальный
# OpenAI из РФ) — раскомментируйте. В большинстве случаев проще
# использовать российский OpenAI-совместимый сервис через OPENAI_BASE_URL.
# HTTPS_PROXY=
# HTTP_PROXY=
