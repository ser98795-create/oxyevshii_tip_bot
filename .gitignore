# Секреты
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Логи и временные файлы
*.log
*.bak
*.swp

# Данные бота на хосте: пустую папку (data/.gitkeep) держим в репо,
# чтобы docker-compose не уронил mount, но сам JSON-файл с досье
# не коммитим — это эфемерные данные конкретного чата.
data/*
!data/.gitkeep
